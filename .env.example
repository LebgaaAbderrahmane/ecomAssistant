# ─────────────────────────────────────────────────────────────────────────────
# ecomAssistant environment reference
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Postgres/Redis/OpenWA URLs shown here are the Docker-network addresses used by
# docker-compose. For a host run, use 127.0.0.1 instead.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=<your-postgres-user>
POSTGRES_PASSWORD=<your-postgres-password>
POSTGRES_DB=<your-postgres-db>
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ─── Redis / BullMQ ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_HOST=redis

# ─── Backend (TypeScript) ────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
INTERNAL_URL=http://back:3000

JWT_SECRET=<your-jwt-secret>
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL=2592000
LOG_LEVEL=info

# ─── OpenAI/OpenWA (WhatsApp gateway) ────────────────────────────────────────
OPENWA_URL=http://openwa:2785
OPENWA_API_KEY=<your-openwa-api-key>
OPENWA_WEBHOOK_SECRET=<your-openwa-webhook-secret>
RESOLVE_LID_TO_PHONE=false

# ─── Shopify ─────────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=<shopify-api-key>
SHOPIFY_API_SECRET=<shopify-api-secret>
SHOPIFY_SCOPES=<shopify-scopes>

# ─── Google / Gemini (used by backend media processing + LLM fallbacks) ──────
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GEMINI_API_KEY_1=<gemini-key-1>
GEMINI_API_KEY_2=<gemini-key-2>
GEMINI_API_KEY_3=<gemini-key-3>
GEMINI_API_KEY_4=<gemini-key-4>
GEMINI_API_KEY_5=<gemini-key-5>
GEMINI_API_KEY_6=<gemini-key-6>
GEMINI_MODEL=<gemini-model>

# ─── Email worker ────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@example.com
EMAIL_PROVIDER_API_KEY=<email-provider-api-key>

# ─── Charges (Chargily) ───────────────────────────────────────────────────────
CHARGILY_BASE_URL=<chargily-base-url>
CHARGILY_PUBLIC_KEY=<chargily-public-key>
CHARGILY_PRIVATE_KEY=<chargily-private-key>

# ─── gRPC (service-to-service) ───────────────────────────────────────────────
# Internal shared secret used for auth between the backend and the agent.
# Set the same value in both services via this .env.
INTERNAL_API_KEY=<shared-internal-api-key>
# Where the backend reaches the agent's AgentService gRPC server. Inside the
# compose network this is the agent service DNS name. The agent container binds
# via its own AGENT_GRPC_ADDR override in docker-compose.yml (0.0.0.0:50052).
AGENT_GRPC_ADDR=agent:50052
# Where the typeScript backend binds its ToolService gRPC server (inside its container).
TOOLS_GRPC_ADDR=0.0.0.0:50051
TOOLS_GRPC_ENABLED=true

# ─── Python Agent (ecom_agent) ───────────────────────────────────────────────
GROQ_API_KEY=<groq-api-key>
GOOGLE_API_KEY=<google-ai-api-key>
LANGSMITH_API_KEY=<langsmith-api-key-optional>
LANGSMITH_PROJECT=<langsmith-project-optional>