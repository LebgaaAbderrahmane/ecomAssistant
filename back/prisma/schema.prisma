generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                         String    @id @default(cuid())
  email                      String    @unique
  passwordHash               String    @default("")
  name                       String
  shopName                   String
  googleId                   String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  isVerified                 Boolean   @default(false)
  verificationTokenHash      String?
  verificationTokenExpiresAt DateTime?

  storeConnections StoreConnection[]
  agentConfig      AgentConfig?
  conversations    Conversation[]
  products         Product[]
  orders           Order[]
  customers        Customer[]
  wilayaCosts      WilayaDeliveryCost[]
  whatsAppSession  WhatsAppSession?
  notifications    Notification[]
  deliveryConfig   DeliveryProviderConfig?
}

model StoreConnection {
  id         String   @id @default(cuid())
  merchantId String
  source     Source
  storeName  String
  storeUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant          Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shopifyConnection ShopifyConnection?

  @@index([merchantId])
}

model ShopifyConnection {
  id                    String    @id @default(cuid())
  storeConnectionId     String    @unique
  shopDomain            String
  accessToken           String
  refreshToken          String?
  tokenExpiresAt        DateTime?
  refreshTokenExpiresAt DateTime?
  scopes                String?
  currency              String    @default("DZD")
  defaultOrderStatus    String    @default("PENDING")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  storeConnection StoreConnection @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)

  @@index([shopDomain])
}

enum Source {
  SHOPIFY
  WOOCOMMERCE
}

model AgentConfig {
  id                   String   @id @default(cuid())
  merchantId           String   @unique
  defaultLanguage      String   @default("auto")
  tone                 String   @default("friendly")
  followUpDelays       Json
  maxFollowUps         Int      @default(3)
  deliveryProvider     String?
  isActive             Boolean  @default(false)
  templates            Json?
  escalationThreshold  Int      @default(3)
  updatedAt            DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Product {
  id                String   @id @default(cuid())
  merchantId        String
  platformProductId String
  name              String
  description       String   @default("")
  price             Float
  currency          String   @default("DZD")
  images            Json
  variants          Json
  stockStatus       String   @default("in_stock")
  category          String?
  agentEnabled      Boolean  @default(true)
  createdAt         DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([merchantId, platformProductId])
  @@index([merchantId])
  @@index([merchantId, createdAt, id])
}





model Customer {
  id         String   @id @default(cuid())
  merchantId String

  phone      String
  name       String?
  language   String?
  blocked    Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@unique([merchantId, phone])
  @@index([merchantId])
}

model Order {
  id               String      @id @default(cuid())
  merchantId       String
  customerId       String
  platformOrderId  String
  wilaya           String
  commune          String?
  address          String
  productId        String
  productName      String
  quantity         Int         @default(1)
  totalAmount      Float
  deliveryCost     Float       @default(0)
  status           OrderStatus @default(PENDING)
  trackingNumber   String?
  deliveryProvider String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  conversation Conversation? @relation("currentOrder")

  @@unique([merchantId, platformOrderId])
  @@index([merchantId])
  @@index([customerId])
}

model Conversation {
  id               String              @id @default(cuid())
  merchantId       String
  customerId       String
  customerPhone    String              @default("")
  currentOrderId   String?             @unique
  owner            ConversationOwner   @default(AI)
  state            ConversationState   @default(IDLE)
  status           ConversationStatus  @default(ACTIVE)
  language         String              @default("auto")
  memory           Json?
  followUpStep     Int                 @default(0)
  takenOverByHuman Boolean             @default(false)
  lastMessageAt    DateTime?
  lastReadMessageAt DateTime?
  escalatedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  currentOrder Order?    @relation("currentOrder", fields: [currentOrderId], references: [id])

  messages     Message[]

  @@unique([merchantId, customerId])
  @@index([merchantId])
  @@index([customerId])
  @@index([state])
  @@index([status])
}

model Message {

  id String @id @default(cuid())

  conversationId String
  role           String
  content        String
  contentType    String   @default("text")
  mediaUrl       String?
  mimeType       String?


  whatsappMessageId String? @unique

  direction MessageDirection

  sender MessageSender

  text String



  rawPayload Json?

  intent String?

  entities Json?

  confidence Float?

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId])
}

model WilayaDeliveryCost {
  id         String @id @default(cuid())
  merchantId String
  wilaya     String
  wilayaCode Int
  cost       Float

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, wilayaCode])
  @@index([merchantId])
}

model WhatsAppSession {
  id          String   @id @default(cuid())
  merchantId  String   @unique
  sessionId   String   @unique
  status      String   @default("disconnected")
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model DeliveryProviderConfig {
  id            String   @id @default(cuid())
  merchantId    String   @unique
  provider      String
  apiId         String?
  apiToken      String?
  isConnected   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(cuid())
  merchantId String
  type       String
  title      String
  message    String
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, read])
  @@index([merchantId, createdAt(sort: Desc)])
}
enum ConversationOwner {
  AI
  MERCHANT
  CUSTOMER
}

enum ConversationStatus {
  ACTIVE
  RESOLVED
}

enum ConversationState {

  IDLE

  GREETING

  PRODUCT_DISCOVERY

  PRODUCT_SELECTED

  WAITING_CONFIRMATION

  CONFIRMED

  SHIPPING

  FINISHED

  CANCELLED
}

enum OrderStatus {

  PENDING

  CONFIRMED

  SHIPPED

  DELIVERED

  CANCELLED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageSender {
  CUSTOMER
  AI
  MERCHANT
}
