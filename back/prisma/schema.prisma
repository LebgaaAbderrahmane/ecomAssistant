generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                         String    @id @default(cuid())
  email                      String    @unique
  passwordHash               String
  name                       String
  shopName                   String
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  isVerified                 Boolean   @default(false)
  verificationTokenHash      String?
  verificationTokenExpiresAt DateTime?

  storeConnections StoreConnection[]
  agentConfig      AgentConfig?
  conversations    Conversation[]
  products         Product[]
  orders           Order[]
  customers        Customer[]
  wilayaCosts      WilayaDeliveryCost[]
  whatsAppSession  WhatsAppSession?
  notifications    Notification[]
}

model StoreConnection {
  id         String   @id @default(cuid())
  merchantId String
  source     Source
  storeName  String
  storeUrl   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant          Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  shopifyConnection ShopifyConnection?

  @@index([merchantId])
}

model ShopifyConnection {
  id                    String    @id @default(cuid())
  storeConnectionId     String    @unique
  shopDomain            String
  accessToken           String
  refreshToken          String?
  tokenExpiresAt        DateTime?
  refreshTokenExpiresAt DateTime?
  scopes                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  storeConnection StoreConnection @relation(fields: [storeConnectionId], references: [id], onDelete: Cascade)

  @@index([shopDomain])
}

enum Source {
  SHOPIFY
  WOOCOMMERCE
}

model AgentConfig {
  id               String   @id @default(cuid())
  merchantId       String   @unique
  defaultLanguage  String   @default("auto")
  tone             String   @default("friendly")
  followUpDelays   Json
  maxFollowUps     Int      @default(3)
  deliveryProvider String?
  isActive         Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Product {
  id                String   @id @default(cuid())
  merchantId        String
  platformProductId String
  name              String
  description       String   @default("")
  price             Float
  currency          String   @default("DZD")
  images            Json
  variants          Json
  stockStatus       String   @default("in_stock")
  category          String?
  createdAt         DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@unique([merchantId, platformProductId])
  @@index([merchantId])
  @@index([merchantId, createdAt, id])
}

model Customer {
  id         String   @id @default(cuid())
  merchantId String
  phone      String
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders        Order[]
  conversations Conversation[]

  @@unique([merchantId, phone])
  @@index([merchantId])
}

model Order {
  id               String   @id @default(cuid())
  merchantId       String
  customerId       String
  platformOrderId  String
  customerName     String
  customerPhone    String
  wilaya           String
  commune          String?
  address          String
  productId        String
  productName      String
  quantity         Int      @default(1)
  totalAmount      Float
  deliveryCost     Float    @default(0)
  status           String   @default("pending")
  trackingNumber   String?
  deliveryProvider String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
  conversation Conversation?

  @@unique([merchantId, platformOrderId])
  @@index([merchantId])
  @@index([customerId])
}

model Conversation {
  id               String            @id @default(cuid())
  merchantId       String
  customerId       String
  currentOrderId   String?   @unique
  customerPhone    String
  status           String            @default("active")
  language         String            @default("auto")
  followUpStep     Int               @default(0)
  lastMessageAt     DateTime?
  lastReadMessageAt DateTime?
  escalatedAt       DateTime?
  takenOverByHuman  Boolean           @default(false)
  createdAt        DateTime          @default(now())

  merchant     Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currentOrder Order?    @relation(fields: [currentOrderId], references: [id])
  messages     Message[]

  @@unique([merchantId, customerId])
  @@index([merchantId])
  @@index([customerId])
  @@index([status])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  contentType    String   @default("text")
  mediaUrl       String?
  mimeType       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model WilayaDeliveryCost {
  id         String @id @default(cuid())
  merchantId String
  wilaya     String
  wilayaCode Int
  cost       Float

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, wilayaCode])
  @@index([merchantId])
}

model WhatsAppSession {
  id          String   @id @default(cuid())
  merchantId  String   @unique
  sessionId   String   @unique
  status      String   @default("disconnected")
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(cuid())
  merchantId String
  type       String
  title      String
  message    String
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, read])
  @@index([merchantId, createdAt(sort: Desc)])
}
